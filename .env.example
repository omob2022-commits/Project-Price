# ─── Database ───────────────────────────────────────────
POSTGRES_USER=landval
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=landval_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://landval:changeme_in_production@localhost:5432/landval_db

# Synchronous URL for Alembic migrations
DATABASE_URL_SYNC=postgresql://landval:changeme_in_production@localhost:5432/landval_db

# ─── Security ──────────────────────────────────────────
SECRET_KEY=replace-with-a-secure-random-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── CORS ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Map Tiles ─────────────────────────────────────────
PMTILES_PATH=frontend/public/tiles/palestine.pmtiles

# ─── OCHA HDX ──────────────────────────────────────────
OCHA_HDX_OSLO_URL=https://data.humdata.org/dataset/oslo-accords-areas-west-bank

# ─── Phase Config ─────────────────────────────────────
# Governorate filter for Phase 1
ACTIVE_GOVERNORATE=Nablus
